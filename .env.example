# Copy this file to .env  (PowerShell: Copy-Item .env.example .env)  and fill in the blanks.
# Never commit .env to git.

# ---- OpenAI ------------------------------------------------------------
OPENAI_API_KEY=
# Any chat model with tool calling works. Cheaper "mini" models are fine for every lab.
OPENAI_MODEL=gpt-5.4-mini

# ---- Your team (shown on the Journal board in the capstone) -----------------
TEAM_NAME=team-yourname

# ---- x402 (Lab 7+). Filled in by: uv run python scripts/make_wallet.py -----
PAYER_PRIVATE_KEY=
PAYER_ADDRESS=
PAY_TO_ADDRESS=

# Where payments are verified and settled.
#   Mock Bank (default, no blockchain): http://127.0.0.1:4022
#   Real Base Sepolia testnet:          https://x402.org/facilitator
FACILITATOR_URL=http://127.0.0.1:4022

# ---- Capstone (Lab 8). Your instructor will give you the address. -----------
# JOURNAL_URL=http://<instructor-ip>:9200
JOURNAL_URL=http://127.0.0.1:9200
REVIEWER_URL=http://127.0.0.1:9201
